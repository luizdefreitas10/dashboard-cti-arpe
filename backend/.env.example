SUPABASE_DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
SUPABASE_DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-YOUR-REGION.pooler.supabase.com:5432/postgres"
CORS_ORIGIN="http://localhost:3000"

# Gere um par RSA e informe em PEM com \n escapado ou base64.
# Em produção, estas duas variáveis são obrigatórias.
AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Sessões longas para PWA/mobile.
AUTH_SESSION_DAYS="30"
AUTH_COOKIE_NAME="cti_session"

# Use "none" + HTTPS quando frontend e API estiverem em domínios diferentes.
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_DOMAIN=""
